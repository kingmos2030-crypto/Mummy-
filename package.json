{
  "name": "mummy-shaft",
  "version": "1.0.0",
  "description": "Mummy شافت — personal media discovery & tracking (metadata only, no video hosting)",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "install:all": "npm install && npm --prefix client install",
    "test": "node --test test/*.test.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingmos2030-crypto/Mummy-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kingmos2030-crypto/Mummy-/issues"
  },
  "homepage": "https://github.com/kingmos2030-crypto/Mummy-#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1"
  }
}
