# ---- Mummy شافت / server-only environment variables ----
# Never prefix any of these with VITE_ : they must stay on the server.

PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────
# Local development: embedded libSQL file (no setup needed).
DATABASE_PATH=./database.sqlite
# DATABASE_URL may also be file:./database.sqlite

# Production (Vercel/serverless): remote SQLite-compatible database over HTTP.
# Create a free Turso database (https://turso.tech) and set:
DATABASE_URL=
#   e.g. libsql://your-db-your-user.turso.io  (https:// also accepted)
DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN are accepted as aliases.

# ── TMDB (free, required for live movie/TV data) ─────────────────────────
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# optional: v4 bearer token instead of the v3 key
TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=ar-SA

# Jikan (MyAnimeList) and TVmaze need no key
JIKAN_BASE_URL=https://api.jikan.moe/v4
TVMAZE_BASE_URL=https://api.tvmaze.com

# Owner profile (single-user mode)
OWNER_USERNAME=mummy
OWNER_DISPLAY_NAME=Mummy

# Caching / networking
CACHE_SEARCH_TTL_MS=21600000
CACHE_DETAILS_TTL_MS=86400000
EXTERNAL_TIMEOUT_MS=8000

# Graceful fallback catalog when the APIs are unreachable
ALLOW_OFFLINE_CATALOG=true

# Public site URL (sitemap / robots)
SITE_URL=
